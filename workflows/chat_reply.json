      "id": "ai-agent-id",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    reply: $input.first().json.output\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0],
      "id": "code-node-id",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
